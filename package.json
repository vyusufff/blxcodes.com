{
  "name": "blxcodes.com",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "check-codes": "node scripts/check-codes.mjs",
    "check-codes:write": "node scripts/check-codes.mjs --write",
    "deploy": "astro build && node scripts/ping-indexnow.mjs && wrangler pages deploy dist --project-name=blxcodes",
    "indexnow": "node scripts/ping-indexnow.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource/outfit": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.5",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "sharp": "^0.35.3",
    "wrangler": "^4.115.0"
  }
}
