---
import { codesHref } from '../lib/games';

interface Props {
  page: number;
  totalPages: number;
  total: number;
}

const { page, totalPages, total } = Astro.props;
---

{
  totalPages > 1 && (
    <nav
      class="mt-10 flex flex-wrap items-center justify-between gap-4 border-t border-line pt-6"
      aria-label="Pagination"
    >
      <p class="text-sm text-muted">
        Page {page} of {totalPages} · {total} games
      </p>
      <div class="flex items-center gap-2">
        {page > 1 ? (
          <a
            href={codesHref(page - 1)}
            class="rounded-md border border-line bg-mist px-4 py-2 text-sm font-bold text-ink hover:border-ink/30"
          >
            Previous
          </a>
        ) : (
          <span class="rounded-md border border-transparent px-4 py-2 text-sm font-bold text-muted">
            Previous
          </span>
        )}
        {page < totalPages ? (
          <a
            href={codesHref(page + 1)}
            class="rounded-md bg-ink px-4 py-2 text-sm font-bold text-mist hover:bg-signal"
          >
            Next
          </a>
        ) : (
          <span class="rounded-md border border-transparent px-4 py-2 text-sm font-bold text-muted">
            Next
          </span>
        )}
      </div>
    </nav>
  )
}
