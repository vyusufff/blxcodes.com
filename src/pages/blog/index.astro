---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<BaseLayout
  title="Roblox Codes Blog"
  description="Guides and updates about redeeming Roblox codes faster."
>
  <Header slot="header" />

  <section class="border-b border-line bg-ink text-white">
    <div class="mx-auto max-w-6xl px-4 py-7 sm:px-6 sm:py-9">
      <p class="text-xs font-bold uppercase tracking-[0.16em] text-signal-deep">Guides</p>
      <h1 class="mt-2 font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Blog</h1>
      <p class="mt-2 max-w-2xl text-sm text-white/70 sm:text-base">
        Practical notes on Roblox codes, redeeming, and staying ahead of expired lists.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-7 sm:px-6 sm:py-9">
    <div class="grid gap-4 sm:grid-cols-2">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group overflow-hidden rounded-xl border border-line bg-white transition hover:border-signal/40 hover:shadow-md"
          >
            {post.data.cover ? (
              <img
                src={post.data.cover}
                alt=""
                width="960"
                height="540"
                loading="lazy"
                class="aspect-[16/9] w-full object-cover transition duration-300 group-hover:scale-[1.02]"
              />
            ) : (
              <div class="flex aspect-[16/9] items-end bg-gradient-to-br from-ink via-ink-soft to-teal/40 p-4">
                <span class="font-display text-2xl font-bold text-white/90">BLXCodes</span>
              </div>
            )}
            <div class="p-4 sm:p-5">
              <p class="text-xs font-bold uppercase tracking-[0.14em] text-muted">
                {post.data.pubDate.toLocaleDateString('en-US', {
                  month: 'short',
                  day: 'numeric',
                  year: 'numeric',
                })}
              </p>
              <h2 class="mt-2 font-display text-xl font-bold text-ink transition group-hover:text-signal">
                {post.data.title}
              </h2>
              <p class="mt-2 text-sm leading-relaxed text-muted">{post.data.description}</p>
              <span class="mt-3 inline-block text-sm font-bold text-teal group-hover:text-signal">
                Read guide →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
