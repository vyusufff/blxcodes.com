---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getCollection, render } from 'astro:content';
import { absoluteUrl, articleJsonLd, breadcrumbJsonLd, DEFAULT_OG } from '../../lib/seo';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const published = post.data.pubDate.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const path = `/blog/${post.id}`;
const ogImage = post.data.cover ? absoluteUrl(post.data.cover) : DEFAULT_OG;
const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Blog', path: '/blog' },
    { name: post.data.title, path },
  ]),
  articleJsonLd({
    title: post.data.title,
    description: post.data.description,
    path,
    datePublished: post.data.pubDate.toISOString(),
    dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
    image: post.data.cover,
  }),
];
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  ogType="article"
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <Header slot="header" />

  <article class="mx-auto max-w-3xl px-4 py-8 sm:px-6 sm:py-10">
    <Breadcrumbs
      items={[{ label: 'Home', href: '/' }, { label: 'Blog', href: '/blog' }, { label: post.data.title }]}
    />
    {
      post.data.cover && (
        <img
          src={post.data.cover}
          alt=""
          width="1200"
          height="675"
          class="mt-4 aspect-[16/9] w-full rounded-xl border border-line object-cover"
        />
      )
    }
    <h1 class="mt-5 font-display text-4xl font-bold tracking-tight text-ink sm:text-5xl">
      {post.data.title}
    </h1>
    <p class="mt-3 text-sm font-bold uppercase tracking-[0.12em] text-muted">
      <time datetime={post.data.pubDate.toISOString()}>{published}</time>
    </p>
    <p class="mt-3 text-base leading-relaxed text-muted">{post.data.description}</p>
    <div
      class="blog-prose mt-8 space-y-4 text-ink-soft [&_a]:font-semibold [&_a]:text-teal [&_h2]:mt-10 [&_h2]:scroll-mt-24 [&_h2]:border-l-4 [&_h2]:border-signal [&_h2]:pl-4 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-bold [&_h2]:text-ink [&_h3]:mt-6 [&_h3]:font-display [&_h3]:text-lg [&_h3]:font-bold [&_h3]:text-ink [&_hr]:my-8 [&_hr]:border-line [&_li]:my-1.5 [&_ol]:list-decimal [&_ol]:space-y-1 [&_ol]:pl-5 [&_p]:leading-relaxed [&_strong]:text-ink [&_table]:mt-4 [&_table]:w-full [&_table]:overflow-hidden [&_table]:rounded-xl [&_table]:border [&_table]:border-line [&_table]:text-sm [&_td]:border-t [&_td]:border-line [&_td]:px-3 [&_td]:py-2.5 [&_th]:bg-paper [&_th]:px-3 [&_th]:py-2.5 [&_th]:text-left [&_th]:font-bold [&_th]:text-ink [&_ul]:list-disc [&_ul]:pl-5"
    >
      <Content />
    </div>
  </article>

  <Footer slot="footer" />
</BaseLayout>
