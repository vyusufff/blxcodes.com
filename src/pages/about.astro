---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { activeCodeCount, getAllGames } from '../lib/games';

const games = await getAllGames();
const gameCount = games.length;
const activeGames = games.filter((game) => activeCodeCount(game) > 0).length;
---

<BaseLayout
  title="About BLX Codes"
  description={`BLX Codes tracks working Roblox codes across ${gameCount} games with clear active/expired lists and one-click copy.`}
>
  <Header slot="header" />

  <section class="mx-auto max-w-3xl px-4 py-12 sm:px-6 sm:py-16">
    <h1 class="font-display text-4xl font-extrabold tracking-tight text-ink sm:text-5xl">About</h1>
    <div class="mt-6 space-y-4 text-base leading-relaxed text-ink-soft">
      <p>
        <strong class="text-ink">BLX Codes</strong> exists for one job: help players find working Roblox
        codes without wading through unrelated gaming news.
      </p>
      <p>
        We currently cover <strong class="text-ink">{gameCount} Roblox games</strong>, and
        <strong class="text-ink"> {activeGames}</strong> of those pages have at least one active code.
        Each page puts working codes first, marks expired codes clearly, and includes one-click copy so
        redeeming takes seconds.
      </p>
      <p>
        Lists are checked automatically throughout the day from public Roblox code sources, then verified
        against live Roblox place data before a brand-new game is added.
      </p>
      <p>
        BLX Codes is an independent site and is not affiliated with Roblox Corporation.
      </p>
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
