---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import GameCard from '../components/GameCard.astro';
import SearchBox from '../components/SearchBox.astro';
import { activeCodeCount, getPopularGames, getRecentlyUpdatedGames } from '../lib/games';
import { getCollection } from 'astro:content';
import { SITE_DESC } from '../lib/seo';
import outfitWoff2 from '@fontsource/outfit/files/outfit-latin-700-normal.woff2?url';

const popular = await getPopularGames(8);
const recentlyUpdated = await getRecentlyUpdatedGames(6);
const posts = (await getCollection('blog'))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
const homeModified =
  popular.length > 0
    ? new Date(Math.max(...popular.map((g) => g.data.updatedAt.valueOf()))).toISOString()
    : new Date().toISOString();
---

<BaseLayout
  title="BLXCodes — Working Roblox Codes"
  description={SITE_DESC}
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'WebPage',
    name: 'BLXCodes — Working Roblox Codes',
    description: SITE_DESC,
    url: 'https://blxcodes.com/',
    dateModified: homeModified,
  }}
>
  <link
    slot="head"
    rel="preload"
    href={outfitWoff2}
    as="font"
    type="font/woff2"
    crossorigin
  />
  <Header slot="header" />

  <section class="relative z-20 overflow-visible border-b border-line">
    <div class="pointer-events-none absolute inset-0 overflow-hidden bg-[radial-gradient(ellipse_80%_60%_at_0%_0%,rgba(255,90,31,0.18),transparent_55%),radial-gradient(ellipse_50%_40%_at_100%_20%,rgba(13,115,119,0.12),transparent_50%),linear-gradient(180deg,#10141c_0%,#1a2230_55%,#243041_100%)]"></div>
    <div class="pointer-events-none absolute inset-0 grid-atmosphere opacity-20" aria-hidden="true"></div>
    <div class="relative z-20 mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
      <div class="flex items-center gap-2 text-sm font-semibold text-white/70">
        <img src="/favicon.svg" alt="BLXCodes" width="18" height="18" style="width:18px;height:18px" class="h-4 w-4" />
        Updated daily
      </div>
      <p
        class="mt-3 font-display text-4xl font-bold leading-none tracking-tighter text-white sm:text-5xl md:text-6xl"
        set:html={'BLX<span class="text-signal">Codes</span>'}
      />
      <h1 class="mt-4 max-w-xl text-lg font-semibold leading-snug text-white/90 sm:text-xl">
        Working Roblox codes, without the clutter.
      </h1>
      <p class="mt-2 max-w-lg text-sm leading-relaxed text-white/65 sm:text-base">
        Search any game, copy active codes in one tap, skip the expired junk.
      </p>
      <div class="relative z-30 mt-5 max-w-xl">
        <SearchBox
          id="hero-search"
          size="hero"
          placeholder="Search Blox Fruits, Adopt Me, Fisch…"
        />
      </div>
    </div>
  </section>

  <section class="relative z-0 mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <div class="flex items-baseline justify-between gap-4">
      <div>
        <h2 class="font-display text-lg font-bold text-ink sm:text-xl">Popular Roblox codes</h2>
        <p class="mt-0.5 text-xs text-muted sm:text-sm">Most-searched games. Fresh active lists.</p>
      </div>
      <a href="/codes/popular" class="shrink-0 text-xs font-semibold text-muted hover:text-signal"
        >View popular →</a
      >
    </div>
    <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-2">
      {
        popular.map((game) => (
          <GameCard
            href={`/codes/${game.id}`}
            gameName={game.data.gameName}
            description={game.data.description}
            updatedAt={game.data.updatedAt}
            activeCount={activeCodeCount(game)}
            cover={game.data.cover}
          />
        ))
      }
    </div>
    <div class="mt-4 flex flex-wrap gap-3 text-xs font-semibold">
      <a href="/codes/updated" class="text-teal hover:text-signal">Recently updated →</a>
      <a href="/codes" class="text-muted hover:text-signal">All games →</a>
    </div>
  </section>

  <section class="border-y border-line bg-paper/50">
    <div class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
      <div class="flex items-baseline justify-between gap-4">
        <div>
          <h2 class="font-display text-lg font-bold text-ink sm:text-xl">Just updated</h2>
          <p class="mt-0.5 text-xs text-muted sm:text-sm">Code lists that changed most recently.</p>
        </div>
        <a href="/codes/updated" class="shrink-0 text-xs font-semibold text-muted hover:text-signal"
          >See all →</a
        >
      </div>
      <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
        {
          recentlyUpdated.map((game) => (
            <GameCard
              href={`/codes/${game.id}`}
              gameName={game.data.gameName}
              description={game.data.description}
              updatedAt={game.data.updatedAt}
              activeCount={activeCodeCount(game)}
              cover={game.data.cover}
            />
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <div class="flex items-baseline justify-between gap-4">
      <div>
        <h2 class="font-display text-lg font-bold text-ink sm:text-xl">Guides</h2>
        <p class="mt-0.5 text-xs text-muted sm:text-sm">Account &amp; safety how-tos.</p>
      </div>
      <a href="/blog" class="shrink-0 text-xs font-semibold text-muted hover:text-signal">Blog →</a>
    </div>
    <div class="mt-4 grid grid-cols-1 gap-2 sm:grid-cols-3">
      {
        posts.map((post) => (
          <a
            href={`/blog/${post.id}`}
            class="group rounded-lg border border-line bg-white px-3 py-2.5 transition hover:border-signal/40"
          >
            <h3 class="font-display text-sm font-bold leading-snug text-ink transition group-hover:text-signal">
              {post.data.title}
            </h3>
            <p class="mt-0.5 line-clamp-1 text-xs text-muted">{post.data.description}</p>
          </a>
        ))
      }
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
