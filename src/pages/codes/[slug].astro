---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CodeList from '../../components/CodeList.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GameCard from '../../components/GameCard.astro';
import { activeCodeCount, getAllGames, getRelatedGames } from '../../lib/games';
import { absoluteUrl, breadcrumbJsonLd, DEFAULT_OG } from '../../lib/seo';

export async function getStaticPaths() {
  const games = await getAllGames();
  return games.map((game) => ({
    params: { slug: game.id },
    props: { game },
  }));
}

const { game } = Astro.props;
const allGames = await getAllGames();
const relatedGames = getRelatedGames(game, allGames);
const checkedAt = game.data.checkedAt ?? game.data.updatedAt;
const updated = game.data.updatedAt.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const checked = checkedAt.toLocaleDateString('en-US', {
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const activeCount = activeCodeCount(game);
const ogImage = game.data.cover ? absoluteUrl(game.data.cover) : DEFAULT_OG;
const monthYear = new Date().toLocaleDateString('en-US', {
  month: 'long',
  year: 'numeric',
});
const pageTitle = `${game.data.gameName} Codes (${monthYear})`;
const pageDescription =
  activeCount > 0
    ? `Copy ${activeCount} working ${game.data.gameName} code${activeCount === 1 ? '' : 's'} for free in-game rewards. Verified ${checked}; expired codes are separated.`
    : `Check the latest ${game.data.gameName} codes status. No working codes are confirmed right now; see expired codes and redemption steps. Verified ${checked}.`;

const faq =
  game.data.faq.length > 0
    ? game.data.faq.map((item) =>
        /^How often are .+ codes updated\?$/i.test(item.q)
          ? {
              ...item,
              a: `We check this list regularly and update it when codes are added or expire. It was last verified on ${checked}.`,
            }
          : item,
      )
    : [
        {
          q: `Are these ${game.data.gameName} codes free?`,
          a: 'Yes. Promo codes unlock free in-game rewards when they are still active.',
        },
        {
          q: `Why did a ${game.data.gameName} code not work?`,
          a: 'It is usually expired, mistyped, or already redeemed on your account.',
        },
        {
          q: `How often are ${game.data.gameName} codes updated?`,
          a: `We check this list regularly and update it when codes are added or expire. It was last verified on ${checked}.`,
        },
      ];

const faqJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faq.map((item) => ({
    '@type': 'Question',
    name: item.q,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.a,
    },
  })),
};

const howToJsonLd =
  game.data.howTo.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'HowTo',
        name: `How to redeem ${game.data.gameName} codes`,
        description: game.data.description,
        step: game.data.howTo.map((text, i) => ({
          '@type': 'HowToStep',
          position: i + 1,
          text,
        })),
      }
    : null;

const webPageJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebPage',
  name: pageTitle,
  description: pageDescription,
  dateModified: game.data.updatedAt.toISOString(),
  url: absoluteUrl(`/codes/${game.id}`),
  isPartOf: { '@type': 'WebSite', name: 'BLXCodes', url: 'https://blxcodes.com' },
};

const crumbs = [
  { label: 'Home', href: '/' },
  { label: 'Codes', href: '/codes' },
  { label: game.data.gameName },
];

const jsonLd = [
  breadcrumbJsonLd([
    { name: 'Home', path: '/' },
    { name: 'Codes', path: '/codes' },
    { name: `${game.data.gameName} Codes`, path: `/codes/${game.id}` },
  ]),
  webPageJsonLd,
  faqJsonLd,
  ...(howToJsonLd ? [howToJsonLd] : []),
];
---

<BaseLayout
  title={pageTitle}
  description={pageDescription}
  ogImage={ogImage}
  jsonLd={jsonLd}
>
  <Header slot="header" />

  <article class="mx-auto max-w-6xl px-4 py-10 sm:px-6 sm:py-12">
    <div class="grid items-start gap-8 lg:grid-cols-[280px_1fr]">
      {
        game.data.cover && (
          <img
            src={game.data.cover}
            alt={`${game.data.gameName} icon`}
            width="560"
            height="560"
            loading="eager"
            fetchpriority="high"
            decoding="async"
            class="w-full max-w-xs rounded-2xl border border-line object-cover shadow-lg lg:max-w-none"
          />
        )
      }
      <div>
        <Breadcrumbs items={crumbs} />
        <h1 class="mt-3 font-display text-4xl font-extrabold text-ink sm:text-5xl">
          {game.data.gameName} Codes
        </h1>
        <p class="mt-4 max-w-2xl text-base leading-relaxed text-muted">{pageDescription}</p>
        <p class="mt-4 text-sm font-bold uppercase tracking-[0.12em] text-ink-soft">
          <time datetime={checkedAt.toISOString()}>Checked {checked}</time>
          {checkedAt.valueOf() !== game.data.updatedAt.valueOf() && (
            <> · <time datetime={game.data.updatedAt.toISOString()}>Changed {updated}</time></>
          )}
          · {activeCount} active
        </p>
      </div>
    </div>

    <section class="mt-12">
      <h2 class="font-display text-2xl font-bold text-ink">Active codes</h2>
      <div class="mt-4">
        <CodeList codes={game.data.codes} status="active" />
      </div>
    </section>

    <section class="mt-10">
      <h2 class="font-display text-2xl font-bold text-ink">Expired codes</h2>
      <div class="mt-4">
        <CodeList codes={game.data.codes} status="expired" />
      </div>
    </section>

    {
      game.data.howTo.length > 0 && (
        <section class="mt-12 max-w-3xl">
          <h2 class="font-display text-2xl font-bold text-ink">How to redeem</h2>
          <ol class="mt-4 list-decimal space-y-2 pl-5 text-ink-soft">
            {game.data.howTo.map((step) => (
              <li class="leading-relaxed">{step}</li>
            ))}
          </ol>
        </section>
      )
    }

    <section class="mt-14 border-t border-line pt-10">
      <h2 class="font-display text-2xl font-bold text-ink">FAQ</h2>
      <div class="mt-6 space-y-5">
        {
          faq.map((item) => (
            <div>
              <h3 class="font-display text-lg font-bold text-ink">{item.q}</h3>
              <p class="mt-2 text-sm leading-relaxed text-muted">{item.a}</p>
            </div>
          ))
        }
      </div>
    </section>

    <section class="mt-14 border-t border-line pt-10">
      <div class="flex items-baseline justify-between gap-4">
        <div>
          <h2 class="font-display text-2xl font-bold text-ink">More Roblox codes</h2>
          <p class="mt-1 text-sm text-muted">Recently updated games and similar experiences.</p>
        </div>
        <a href="/codes" class="shrink-0 text-sm font-semibold text-muted hover:text-signal">View all →</a>
      </div>
      <div class="mt-5 grid grid-cols-1 gap-2 sm:grid-cols-2">
        {
          relatedGames.map((related) => (
            <GameCard
              href={`/codes/${related.id}`}
              gameName={related.data.gameName}
              description={related.data.description}
              updatedAt={related.data.updatedAt}
              activeCount={activeCodeCount(related)}
              cover={related.data.cover}
            />
          ))
        }
      </div>
    </section>
  </article>

  <Footer slot="footer" />
</BaseLayout>
