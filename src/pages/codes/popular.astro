---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GameCard from '../../components/GameCard.astro';
import { activeCodeCount, getPopularGames } from '../../lib/games';

const games = await getPopularGames(36);
const modified =
  games.length > 0
    ? new Date(Math.max(...games.map((g) => g.data.updatedAt.valueOf()))).toISOString()
    : new Date().toISOString();
---

<BaseLayout
  title="Most Popular Roblox Codes"
  description="Working codes for the most-played Roblox games — Blox Fruits, Grow a Garden, Steal a Brainrot, and more. Active lists, updated regularly."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Most Popular Roblox Codes',
    url: 'https://blxcodes.com/codes/popular/',
    dateModified: modified,
  }}
>
  <Header slot="header" />

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <p class="text-xs font-bold uppercase tracking-[0.14em] text-muted">
      <a href="/codes" class="hover:text-signal">Codes</a>
      <span class="mx-1.5 text-line">/</span>
      Popular
    </p>
    <h1 class="mt-2 font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
      Most popular Roblox codes
    </h1>
    <p class="mt-1.5 max-w-2xl text-sm text-muted">
      A short list of high-demand games — not the full catalog. Use this when you want codes players
      search for most. For everything else, browse
      <a href="/codes" class="font-semibold text-teal hover:text-signal">all codes</a>
      or
      <a href="/codes/updated" class="font-semibold text-teal hover:text-signal">recently updated</a>.
    </p>

    <div class="mt-5 grid grid-cols-1 gap-2 sm:grid-cols-2">
      {
        games.map((game) => (
          <GameCard
            href={`/codes/${game.id}`}
            gameName={game.data.gameName}
            description={game.data.description}
            updatedAt={game.data.updatedAt}
            activeCount={activeCodeCount(game)}
            cover={game.data.cover}
          />
        ))
      }
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
