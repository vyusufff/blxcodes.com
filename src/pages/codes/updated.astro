---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import GameCard from '../../components/GameCard.astro';
import { activeCodeCount, getRecentlyUpdatedGames } from '../../lib/games';

const games = await getRecentlyUpdatedGames(36);
const modified =
  games.length > 0
    ? new Date(Math.max(...games.map((g) => g.data.updatedAt.valueOf()))).toISOString()
    : new Date().toISOString();
---

<BaseLayout
  title="Recently Updated Roblox Codes"
  description="Roblox code lists refreshed most recently — new active codes and expired cleanups in one place."
  jsonLd={{
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Recently Updated Roblox Codes',
    url: 'https://blxcodes.com/codes/updated/',
    dateModified: modified,
  }}
>
  <Header slot="header" />

  <section class="mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10">
    <p class="text-xs font-bold uppercase tracking-[0.14em] text-muted">
      <a href="/codes" class="hover:text-signal">Codes</a>
      <span class="mx-1.5 text-line">/</span>
      Updated
    </p>
    <h1 class="mt-2 font-display text-2xl font-bold tracking-tight text-ink sm:text-3xl">
      Recently updated codes
    </h1>
    <p class="mt-1.5 max-w-2xl text-sm text-muted">
      Games whose code lists changed most recently. Fresh drops surface here first. Prefer big titles?
      See
      <a href="/codes/popular" class="font-semibold text-teal hover:text-signal">popular codes</a>.
    </p>

    <div class="mt-5 grid grid-cols-1 gap-2 sm:grid-cols-2">
      {
        games.map((game) => (
          <GameCard
            href={`/codes/${game.id}`}
            gameName={game.data.gameName}
            description={game.data.description}
            updatedAt={game.data.updatedAt}
            activeCount={activeCodeCount(game)}
            cover={game.data.cover}
          />
        ))
      }
    </div>
  </section>

  <Footer slot="footer" />
</BaseLayout>
